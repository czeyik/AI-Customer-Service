ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://dudu:<url-encoded-password>@db:5432/dudu_support
POSTGRES_PASSWORD=<database-password>
SECRET_KEY=<random-session-secret-at-least-32-characters>
SECRET_MANAGER=aws-secrets-manager
ADMIN_TOTP_SECRETS={"admin/czeyik/totp":"<base32-secret>","admin/jane/totp":"<base32-secret>"}

CADDY_EMAIL=<tls-contact-email>
TRUSTED_HOSTS=support.duducaradmin.com
CORS_ORIGINS=

META_VERIFY_TOKEN=<private-verify-token>
META_APP_SECRET=<meta-app-secret>
META_ACCESS_TOKEN=<meta-system-user-token>
META_PHONE_NUMBER_ID=<numeric-phone-number-id>
META_GRAPH_API_VERSION=v26.0
META_SEND_ENABLED=false
META_SEND_TIMEOUT_SECONDS=10
META_SEND_MAX_ATTEMPTS=5

MEDIA_PROCESSING_ENABLED=true
MEDIA_REGION=ap-southeast-5
MEDIA_SIGNED_URL_SECONDS=300
MEDIA_MAX_ATTEMPTS=3
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=20

LLM_ENABLED=true
LLM_CUSTOMER_CONTEXT_ENABLED=false
ZAI_API_KEY=<zai-api-key>
LLM_MODEL=glm-5.3-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_INPUT_CHARS=15000
LLM_MAX_OUTPUT_TOKENS=300
INTAKE_EXPIRY_MINUTES=60
WEBSITE_KNOWLEDGE_URLS=[]

NOTIFICATION_SEND_ENABLED=false
NOTIFICATION_MAX_ATTEMPTS=5
SMTP_HOST=<smtp-host>
SMTP_PORT=465
SMTP_USERNAME=<smtp-username>
SMTP_PASSWORD=<smtp-password>
SMTP_FROM_ADDRESS=<sender-address>
NOTIFICATION_TEMPLATE_NAMES={}

RATE_LIMIT_MESSAGES_PER_MINUTE=20
PUBLIC_BETA_ENABLED=false
PUBLIC_BETA_START_DATE=2026-09-10
PUBLIC_BETA_END_DATE=2026-09-30
PUBLIC_BETA_MESSAGES_PER_USER_DAY=200
PUBLIC_BETA_MESSAGES_PER_DAY=2000
PUBLIC_BETA_MESSAGES_TOTAL=10000
RATE_LIMIT_ADMIN_ATTEMPTS=5
RATE_LIMIT_ADMIN_WINDOW_SECONDS=900
RATE_LIMIT_MAX_KEYS=10000
RETRIEVAL_MIN_CONFIDENCE=0.12
CHAT_LOG_RETENTION_DAYS=90
TICKET_RETENTION_MONTHS=36
BACKUP_RETENTION_DAYS=35
BACKUP_INTERVAL_MINUTES=60
BACKUP_PREFIX=backups/postgresql
PRIVACY_OWNER_USERNAME=czeyik
RETENTION_BATCH_SIZE=100
